  "npcs": [
    {
      "id": "producer",
      "object": "NPC_PRODUCER",
      "name": "Mira Chen",
      "role": "制作人",
      "position": [
        3.2,
        0.0,
        -8.4
      ],
      "lines": [
        "欢迎来到源码港。今晚我们要把 v1.0 送上线。",
        "先把散落的 Commit 晶体捡齐，别让版本树断枝。",
        "引擎馆编译、美术馆烘焙、QA 压测，最后去码头点火。",
        "你是今晚的值班制作人。走吧，世界等一个可玩的构建。"
      ]
    },
    {
      "id": "engineer",
      "object": "NPC_ENGINEER",
      "name": "Ken Okada",
      "role": "引擎工程师",
      "position": [
        -22.0,
        0.0,
        -13.6
      ],
      "lines": [
        "内核还在热重载。三台终端都要跑绿才能过编译门。",
        "看见发光的屏幕就按 E。别一次点三台，管线会抢锁。",
        "编译通过后把产物交给 QA，Rex 今晚心情一般。"
      ]
    },
    {
      "id": "artist",
      "object": "NPC_ARTIST",
      "name": "Lina Voss",
      "role": "美术总监",
      "position": [
        22.0,
        0.0,
        -13.6
      ],
      "lines": [
        "灯光还没bake。两座雕塑都要烘焙，不然发版会粉扑扑。",
        "Blender 里的法线你已经看见了——现在让游戏里也看见。",
        "藏了一只橡胶鸭在灌木里。调试的时候它很灵。"
      ]
    },
    {
      "id": "qa",
      "object": "NPC_QA",
      "name": "Rex Alvarez",
      "role": "QA 主理",
      "position": [
        -22.0,
        0.0,
        11.4
      ],
      "lines": [
        "竞技场里全是漏网 Bug。左键调试器，打中就 squash。",
        "被咬到会掉专注。专注归零就从入口重来，Bug 不会等你。",
        "十只清完，我放行发版。别把崩溃带上飞船。"
      ]
    }
  ],
